# prod 栈 profile，生产不要使用 local 默认 token
V5_PROFILE=prod

# Release 镜像版本；普通用户只拉取该固定版本，不在本机编译。
ASTERISM_VERSION=0.1.4
ASTERISM_IMAGE_SOURCE=release
ASTERISM_PULL_POLICY=missing

# 首次启动 admin 密码；留空会随机生成并在 control-plane 首次插入 admin 时打印一次
V5_ADMIN_INITIAL_PASSWORD=

# smoke 登录密码；填首次启动日志中的随机密码或与上项相同的显式密码
V5_SMOKE_ADMIN_PASSWORD=

# 默认使用 Docker Compose；统一入口会自动检测 Apple Container。
V5_CONTAINER_RUNTIME=docker

# Apple container 无法直连外网时，在当前 shell export HTTP 代理；回环地址会自动映射到宿主机
V5_APPLE_PROXY_URL=

# Docker 内 DeepSeek 等外网 TLS 不稳定时可选；端口按宿主代理实际配置填写
V5_OUTBOUND_PROXY_URL=

# Docker 出站代理绕过列表，按需完整覆盖
V5_NO_PROXY=localhost,127.0.0.1,host.docker.internal,host.container.internal,postgres,temporal,server,runner

# worker 回调 control-plane 的 bearer token，必须改成随机长串
V5_WORKER_CALLBACK_TOKEN=change-me-worker-token

# PostgreSQL 账号密码，需和 docker-compose postgres 一致
V5_DB_USER=asterism
V5_DB_PASSWORD=

# GitLab 全局默认连接；系统配置可覆盖，Token 只写入且页面仅显示已配置状态
ASTERISM_GITLAB_BASE_URL=
ASTERISM_GITLAB_TOKEN=

# 写入 GitLab MR 描述的 Workbench 地址；服务器部署时改为用户可访问的 A 地址
V5_PUBLIC_URL=http://127.0.0.1:8080

# agent-service 默认模型名
V5_AGENT_MODEL=gpt-4.1-mini

# agent-service 默认 OpenAI 兼容 base url，可空
V5_AGENT_BASE_URL=

# agent-service 兼容回退 API key；系统页面未配置业务模型时才使用
V5_AGENT_API_KEY=

# control-plane 内部 model-config 查询地址，compose 内保持默认
V5_AGENT_CONTROL_PLANE_URL=http://server:8085

# worker 可访问的宿主机仓库根目录，系统 repoPath 需落在该挂载下
V5_REPO_ROOT=/tmp

# 未配置 developer Profile 时的 worker 默认模型；推荐在页面按系统配置
V5_MODEL_PROVIDER=anthropic
V5_MODEL=
V5_MODEL_BASE_URL=
V5_MODEL_API_KEY=

# Claude SDK Supervisor 默认执行预算
V5_ENGINE_MAX_TURNS=50
V5_ENGINE_TIMEOUT_SECONDS=600
V5_ENGINE_EFFORT_LEVEL=

# release 是否 push wi/* 分支，默认只本地 commit
V5_RELEASE_PUSH=false

# smoke-gitlab 默认保留临时项目便于审计；确认允许删除后才显式设为 yes
V5_SMOKE_GITLAB_CLEANUP=no
